# Local-only patch that restores the "Continue as guest" auth bypass for
# development. Not shipped: the pushed frontend requires Google sign-in.
# Re-apply with: git apply .guest-login.patch
# Remove again with: git apply -R .guest-login.patch
.guest-login.patch
